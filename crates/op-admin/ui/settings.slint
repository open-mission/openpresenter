import { Brand } from "theme.slint";
import {
    DropDownMenu,
    IconButton,
    MaterialPalette,
    MaterialWindow,
    MenuItem,
    ScrollView,
    Switch,
    TextButton,
} from "@material";

// Cartão de uma saída: estado, ativação, monitor, modo e ação de visibilidade.
component OutputCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> enabled;
    in-out property <int> monitor-index;
    in-out property <int> mode-index;
    in property <[MenuItem]> monitor-items;
    in property <[MenuItem]> mode-items;
    in property <string> status;
    in property <int> status-kind;
    in property <bool> output-visible;
    in property <bool> controls-enabled;

    callback enabled-changed(bool);
    callback monitor-selected(int);
    callback mode-selected(int);
    callback visibility-toggled();

    property <color> status-color: root.status-kind == 1
        ? Brand.success
        : root.status-kind == 2
        ? Brand.warning
        : root.status-kind == 3
        ? MaterialPalette.error
        : Brand.muted;

    background: Brand.surface;
    border-radius: Brand.radius;
    border-width: 1px;
    border-color: Brand.outline;

    VerticalLayout {
        padding: 20px;
        spacing: 18px;

        HorizontalLayout {
            spacing: 16px;
            cross-axis-alignment: start;

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    color: Brand.ink;
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: root.description;
                    color: Brand.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: 26px;
                border-radius: 13px;
                background: root.status-color.with_alpha(0.12);
                border-width: 1px;
                border-color: root.status-color.with_alpha(0.32);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.status-color;
                    }

                    Text {
                        text: root.status;
                        color: root.status-color;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 18px;
            cross-axis-alignment: end;

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Ativa";
                    color: Brand.muted;
                    font-size: 12px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    height: 56px;
                    cross-axis-alignment: center;

                    Switch {
                        checked <=> root.enabled;
                        enabled: root.controls-enabled;

                        checked_state_changed(value) => {
                            root.enabled-changed(value);
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                Text {
                    text: "Monitor";
                    color: Brand.muted;
                    font-size: 12px;
                    font-weight: 600;
                }

                DropDownMenu {
                    label: "Monitor";
                    items: root.monitor-items;
                    current_index <=> root.monitor-index;
                    enabled: root.controls-enabled;

                    selected(index) => {
                        root.monitor-selected(index);
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                Text {
                    text: "Modo";
                    color: Brand.muted;
                    font-size: 12px;
                    font-weight: 600;
                }

                DropDownMenu {
                    label: "Modo";
                    items: root.mode-items;
                    current_index <=> root.mode-index;
                    enabled: root.controls-enabled;

                    selected(index) => {
                        root.mode-selected(index);
                    }
                }
            }

            TextButton {
                text: root.output-visible ? "Fechar" : "Abrir agora";
                enabled: root.controls-enabled && root.enabled;

                clicked => {
                    root.visibility-toggled();
                }
            }
        }
    }
}

component Banner inherits Rectangle {
    in property <string> message;
    in property <bool> warning;

    property <color> accent: root.warning ? Brand.warning : MaterialPalette.error;

    background: root.accent.with_alpha(0.12);
    border-radius: 12px;
    border-width: 1px;
    border-color: root.accent.with_alpha(0.32);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;

        Text {
            text: root.message;
            color: root.accent;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

export component SettingsWindow inherits MaterialWindow {
    in property <[MenuItem]> public-monitor-items;
    in property <[MenuItem]> stage-monitor-items;
    in property <[MenuItem]> mode-items;
    in-out property <bool> public-enabled;
    in-out property <bool> stage-enabled;
    in-out property <int> public-monitor-index;
    in-out property <int> stage-monitor-index;
    in-out property <int> public-mode-index;
    in-out property <int> stage-mode-index;
    in property <string> public-status;
    in property <string> stage-status;
    in property <int> public-status-kind;
    in property <int> stage-status-kind;
    in property <bool> public-visible;
    in property <bool> stage-visible;
    in property <bool> single-monitor;
    in property <string> monitor-warning;
    in property <string> database-error;
    in property <string> persistence-error;
    in property <bool> controls-enabled;

    callback public-enabled-changed(bool);
    callback stage-enabled-changed(bool);
    callback public-monitor-selected(int);
    callback stage-monitor-selected(int);
    callback public-mode-selected(int);
    callback stage-mode-selected(int);
    callback public-visibility-toggled();
    callback stage-visibility-toggled();
    callback close-requested();

    title: "Configurações — OpenPresenter";
    icon: @image-url("../../../assets/branding/open-presenter-app-icon.svg");
    width: 820px;
    height: 600px;
    background: Brand.page;

    VerticalLayout {
        min-width: 720px;
        min-height: 540px;

        // Cabeçalho da janela.
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 14px;
            cross-axis-alignment: center;

            Image {
                source: @image-url("../../../assets/branding/open-presenter-app-icon.svg");
                width: 40px;
                height: 40px;
                image-fit: contain;
            }

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "Configurações";
                    color: Brand.ink;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "OpenPresenter";
                    color: Brand.muted;
                    font-size: 12px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            IconButton {
                icon: @image-url("../../../vendor/material-1.1.0/ui/icons/close.svg");
                tooltip: "Fechar";

                clicked => {
                    root.close-requested();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Brand.outline;
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Barra lateral: apenas a aba Saídas nesta versão.
            Rectangle {
                width: 190px;
                background: Brand.surface-muted;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 22px;
                    padding-bottom: 22px;
                    spacing: 12px;

                    Text {
                        text: "CONFIGURAÇÕES";
                        color: Brand.subtle;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.2px;
                    }

                    Rectangle {
                        height: 42px;
                        border-radius: 12px;
                        background: Brand.surface;
                        border-width: 1px;
                        border-color: Brand.outline;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            cross-axis-alignment: center;

                            Text {
                                text: "Saídas";
                                color: Brand.ink;
                                font-size: 14px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Brand.outline;
            }

            ScrollView {
                VerticalLayout {
                    width: parent.width;
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 16px;

                    Text {
                        text: "Escolha onde cada saída deve aparecer. As alterações são aplicadas imediatamente.";
                        color: Brand.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    if root.database-error != "" : Banner {
                        message: root.database-error;
                    }

                    if root.persistence-error != "" : Banner {
                        message: root.persistence-error;
                    }

                    if root.monitor-warning != "" : Banner {
                        message: root.monitor-warning;
                        warning: true;
                    }

                    if root.single-monitor : Text {
                        text: "Com um único monitor, as saídas abrem como janelas.";
                        color: Brand.subtle;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // Título e descrição espelham OutputKind::label_pt_br e
                    // OutputKind::description_pt_br.
                    OutputCard {
                        title: "Public";
                        description: "Saída visível ao público.";
                        enabled <=> root.public-enabled;
                        monitor-index <=> root.public-monitor-index;
                        mode-index <=> root.public-mode-index;
                        monitor-items: root.public-monitor-items;
                        mode-items: root.mode-items;
                        status: root.public-status;
                        status-kind: root.public-status-kind;
                        output-visible: root.public-visible;
                        controls-enabled: root.controls-enabled;

                        enabled-changed(value) => {
                            root.public-enabled-changed(value);
                        }

                        monitor-selected(index) => {
                            root.public-monitor-selected(index);
                        }

                        mode-selected(index) => {
                            root.public-mode-selected(index);
                        }

                        visibility-toggled => {
                            root.public-visibility-toggled();
                        }
                    }

                    OutputCard {
                        title: "Stage";
                        description: "Retorno para o palco e o apresentador.";
                        enabled <=> root.stage-enabled;
                        monitor-index <=> root.stage-monitor-index;
                        mode-index <=> root.stage-mode-index;
                        monitor-items: root.stage-monitor-items;
                        mode-items: root.mode-items;
                        status: root.stage-status;
                        status-kind: root.stage-status-kind;
                        output-visible: root.stage-visible;
                        controls-enabled: root.controls-enabled;

                        enabled-changed(value) => {
                            root.stage-enabled-changed(value);
                        }

                        monitor-selected(index) => {
                            root.stage-monitor-selected(index);
                        }

                        mode-selected(index) => {
                            root.stage-mode-selected(index);
                        }

                        visibility-toggled => {
                            root.stage-visibility-toggled();
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Brand.outline;
        }

        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 16px;
            cross-axis-alignment: center;

            Text {
                text: "As alterações são aplicadas imediatamente.";
                color: Brand.subtle;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            TextButton {
                text: "Fechar";

                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
