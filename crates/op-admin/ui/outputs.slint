import { Brand } from "theme.slint";

// Saída visível ao público. Placeholder de marca, responsivo e adaptável à resolução.
export component PublicWindow inherits Window {
    in-out property <length> viewport-width: 960px;
    in-out property <length> viewport-height: 540px;

    title: "OpenPresenter — Público";
    icon: @image-url("../../../assets/branding/open-presenter-app-icon.svg");
    width: root.viewport-width;
    height: root.viewport-height;
    background: Brand.output-bg;

    // Escala dinâmica calculada a partir do viewport
    property <float> scale-factor: max(0.8, min(root.viewport-width / 960px, root.viewport-height / 540px));

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        padding: 40px;
        spacing: 28px * root.scale-factor;

        Image {
            source: @image-url("../../../assets/branding/open-presenter-wordmark-dark.svg");
            width: min(root.viewport-width * 0.65, 360px * root.scale-factor);
            height: self.width * 0.3267;
            image-fit: contain;
        }

        Text {
            text: "SAÍDA PÚBLICA";
            color: Brand.output-muted;
            font-size: max(12px, 14px * root.scale-factor);
            font-weight: 700;
            letter-spacing: 3px * root.scale-factor;
            horizontal-alignment: center;
        }

        Text {
            text: "Aguardando conteúdo da apresentação";
            color: Brand.output-ink;
            font-size: max(18px, 22px * root.scale-factor);
            horizontal-alignment: center;
        }
    }
}

// Retorno para o palco: relógio e data, com layout distribuído e responsivo para tela cheia.
export component StageWindow inherits Window {
    in property <string> clock-time: "00:00:00";
    in property <string> date-label: "";
    in-out property <length> viewport-width: 720px;
    in-out property <length> viewport-height: 480px;

    title: "OpenPresenter — Palco";
    icon: @image-url("../../../assets/branding/open-presenter-app-icon.svg");
    width: root.viewport-width;
    height: root.viewport-height;
    background: Brand.output-bg;

    // Escala dinâmica calculada a partir do viewport
    property <float> scale-factor: max(0.8, min(root.viewport-width / 720px, root.viewport-height / 480px));

    VerticalLayout {
        padding: 36px;
        padding-left: 48px;
        padding-right: 48px;
        spacing: 20px;
        alignment: space-between;

        // Cabeçalho: Identificação e Data
        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;

            Text {
                text: "RETORNO DE PALCO";
                color: Brand.output-accent;
                font-size: max(12px, 14px * root.scale-factor);
                font-weight: 700;
                letter-spacing: 3px;
            }

            Text {
                text: date-label;
                color: Brand.output-muted;
                font-size: max(13px, 16px * root.scale-factor);
                font-weight: 500;
            }
        }

        // Centro: Relógio em destaque visível a longa distância, ocupando o espaço central
        VerticalLayout {
            alignment: center;
            vertical-stretch: 1;

            Text {
                text: clock-time;
                color: Brand.output-ink;
                font-size: min(max(80px, root.viewport-width * 0.18), 260px);
                font-weight: 700;
                horizontal-alignment: center;
            }
        }

        // Base: Divisor e Informação do Evento / Apresentação
        VerticalLayout {
            spacing: 12px;

            Rectangle {
                height: 2px;
                background: Brand.output-surface;
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Nenhum evento carregado";
                    color: Brand.output-ink;
                    font-size: max(18px, 22px * root.scale-factor);
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Aguardando apresentação";
                    color: Brand.output-muted;
                    font-size: max(13px, 15px * root.scale-factor);
                    horizontal-alignment: center;
                }
            }
        }
    }
}
