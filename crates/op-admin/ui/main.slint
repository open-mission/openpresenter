import { Brand } from "theme.slint";
import { PublicWindow, StageWindow } from "outputs.slint";
import { SettingsWindow } from "settings.slint";
import { CommandPalette, PaletteItemData } from "command_palette.slint";
import { IconButton, MaterialWindow, MenuItem, PopupMenu } from "@material";
import { ListView } from "std-widgets.slint";

export { PublicWindow, SettingsWindow, StageWindow, PaletteItemData }

// Item da biblioteca de mídias/recursos (Sidebar)
export struct MediaLibraryItemData {
    id: string,
    title: string,
    category: string,
    icon: string,
    details: string,
}

// Item na ordem da programação do culto/evento
export struct ProgramItemData {
    id: string,
    order: int,
    title: string,
    subtitle: string,
    kind-label: string,
    kind-icon: string,
    slides-count: int,
    is-active: bool,
}

// Slide individual para o painel de preview
export struct SlidePreviewData {
    index: int,
    label: string,
    text-content: string,
    is-live: bool,
}

export component MainWindow inherits MaterialWindow {
    in property <string> app-name: "OpenPresenter";
    in property <string> app-version: "0.3.0";
    in property <bool> db-ready: true;
    in property <string> db-error: "";
    in property <string> public-status-label: "Público: Aberta";
    in property <int> public-status-kind: 1; // 0=neutro, 1=sucesso, 2=aviso, 3=erro
    in property <string> stage-status-label: "Palco: Oculta";
    in property <int> stage-status-kind: 0;

    // Estado da Command Palette
    in-out property <bool> command-palette-open: false;
    in-out property <string> palette-search-query: "";
    in-out property <int> palette-selected-category: 0;
    in-out property <int> palette-selected-index: 0;
    in property <[PaletteItemData]> palette-results: [];

    // Estado da Sidebar de Mídias
    in-out property <int> media-filter-index: 0; // 0=Todos, 1=Louvor, 2=Bíblia, 3=Mídias, 4=Avisos
    in property <[MediaLibraryItemData]> media-library-items: [];

    // Estado da Programação
    in property <string> program-title: "Culto de Domingo — Noite";
    in property <string> program-subtitle: "Ordem do Evento";
    in property <[ProgramItemData]> program-items: [];
    in-out property <string> selected-program-item-id: "";

    // Estado do Preview dos Slides
    in property <string> preview-header-title: "Nenhum item selecionado";
    in property <string> preview-header-subtitle: "Selecione um item da programação para pré-visualizar os slides";
    in property <[SlidePreviewData]> preview-slides: [];
    in-out property <int> selected-slide-index: 0;
    in-out property <int> live-slide-index: -1;
    in-out property <bool> is-blackout: false;
    in-out property <bool> is-clear-text: false;
    in-out property <bool> is-logo-screen: false;

    // Callbacks do Sistema
    callback open-settings();
    callback toggle-command-palette();
    callback close-command-palette();
    callback palette-query-changed(string);
    callback palette-category-selected(int);
    callback palette-execute-command(string);

    // Callbacks de Ação de Projeção
    callback select-media-library-item(string);
    callback add-media-to-program(string);
    callback select-program-item(string);
    callback remove-program-item(string);
    callback move-program-item-up(string);
    callback move-program-item-down(string);
    callback select-slide(int);
    callback action-go-live(int);
    callback action-toggle-blackout();
    callback action-toggle-clear-text();
    callback action-toggle-logo();

    title: app-name + " — Painel Operacional";
    icon: @image-url("../../../assets/branding/open-presenter-app-icon.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Brand.page;

    // Captura global de atalhos de teclado (⌘K, Ctrl+K, ESC e teclas de função)
    keyboard-scope := FocusScope {
        key-pressed(event) => {
            // Cmd+K (macOS) ou Ctrl+K (Windows/Linux)
            if ((event.modifiers.meta || event.modifiers.control) && (event.text == "k" || event.text == "K")) {
                root.toggle-command-palette();
                return accept;
            }

            // Tecla ESC para fechar Command Palette
            if (event.text == Key.Escape && root.command-palette-open) {
                root.close-command-palette();
                return accept;
            }

            // Atalhos rápidos de projeção
            if (event.text == Key.F5) {
                root.action-toggle-blackout();
                return accept;
            }
            if (event.text == Key.F6) {
                root.action-toggle-clear-text();
                return accept;
            }
            if (event.text == Key.F7) {
                root.action-toggle-logo();
                return accept;
            }

            reject
        }

        VerticalLayout {
            // 1. Barra Superior (Header / Toolbar)
            header-bar := Rectangle {
                height: 54px;
                background: Brand.surface;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 16px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    // Marca e Logotipo
                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;

                        Image {
                            source: Brand.dark
                                ? @image-url("../../../assets/branding/open-presenter-wordmark-dark.svg")
                                : @image-url("../../../assets/branding/open-presenter-wordmark.svg");
                            width: 154px;
                            height: 38px;
                            image-fit: contain;
                        }

                        Rectangle {
                            width: 58px;
                            height: 22px;
                            border-radius: 11px;
                            background: Brand.surface-muted;
                            border-width: 1px;
                            border-color: Brand.outline;

                            Text {
                                text: "v" + root.app-version;
                                color: Brand.muted;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    // Botão central da Command Palette (Barra de busca ágil)
                    palette-trigger := Rectangle {
                        width: 380px;
                        height: 36px;
                        border-radius: 18px;
                        background: search-touch.has-hover ? (Brand.dark ? #222734 : #E2E8F0) : Brand.surface-muted;
                        border-width: 1px;
                        border-color: search-touch.has-hover ? (Brand.dark ? #4B5563 : #CBD5E1) : Brand.outline;

                        search-touch := TouchArea {
                            clicked => {
                                root.toggle-command-palette();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: space-between;
                            cross-axis-alignment: center;

                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: "🔍";
                                    font-size: 13px;
                                }

                                Text {
                                    text: "Buscar músicas, bíblia ou comandos…";
                                    color: Brand.muted;
                                    font-size: 13px;
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 20px;
                                border-radius: 5px;
                                background: Brand.surface;
                                border-width: 1px;
                                border-color: Brand.outline;

                                Text {
                                    text: "⌘K";
                                    color: Brand.subtle;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }

                    // Badges de Status das Saídas e Menu de Configurações
                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;

                        // Badge Public
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: Brand.surface-muted;
                            border-width: 1px;
                            border-color: Brand.outline;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.public-status-kind == 1 ? Brand.success : (root.public-status-kind == 2 ? Brand.warning : Brand.muted);
                                }

                                Text {
                                    text: root.public-status-label;
                                    color: Brand.ink;
                                    font-size: 12px;
                                    font-weight: 500;
                                }
                            }
                        }

                        // Badge Stage
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: Brand.surface-muted;
                            border-width: 1px;
                            border-color: Brand.outline;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.stage-status-kind == 1 ? Brand.success : (root.stage-status-kind == 2 ? Brand.warning : Brand.muted);
                                }

                                Text {
                                    text: root.stage-status-label;
                                    color: Brand.ink;
                                    font-size: 12px;
                                    font-weight: 500;
                                }
                            }
                        }

                        menu-button := IconButton {
                            icon: @image-url("../../../vendor/material-1.1.0/ui/icons/menu.svg");
                            tooltip: "Menu";

                            clicked => {
                                settings-menu.show();
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Brand.outline;
            }

            // 2. Área de Trabalho Principal (3 Colunas: Sidebar de Mídias | Programação | Preview)
            workspace-area := HorizontalLayout {
                vertical-stretch: 1;

                // ==========================================
                // COLUNA 1: SIDEBAR LATERAL (Mídias e Recursos)
                // ==========================================
                sidebar-column := Rectangle {
                    width: 250px;
                    background: Brand.surface;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        // Cabeçalho da Sidebar
                        HorizontalLayout {
                            alignment: space-between;
                            cross-axis-alignment: center;

                            Text {
                                text: "MÍDIAS DO EVENTO";
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Brand.subtle;
                            }

                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: add-media-touch.has-hover ? Brand.surface-muted : transparent;

                                Text {
                                    text: "+";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Brand.ink;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                add-media-touch := TouchArea {
                                    clicked => {
                                        root.toggle-command-palette();
                                    }
                                }
                            }
                        }

                        // Categorias de Mídia (Pills)
                        media-categories := HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.media-filter-index == 0 ? (Brand.dark ? #2A303C : #E2E8F0) : transparent;
                                Text {
                                    text: "Todos";
                                    font-size: 11px;
                                    font-weight: root.media-filter-index == 0 ? 700 : 500;
                                    color: root.media-filter-index == 0 ? Brand.ink : Brand.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                TouchArea { clicked => { root.media-filter-index = 0; } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.media-filter-index == 1 ? (Brand.dark ? #2A303C : #E2E8F0) : transparent;
                                Text {
                                    text: "Louvor";
                                    font-size: 11px;
                                    font-weight: root.media-filter-index == 1 ? 700 : 500;
                                    color: root.media-filter-index == 1 ? Brand.ink : Brand.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                TouchArea { clicked => { root.media-filter-index = 1; } }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                border-radius: 6px;
                                background: root.media-filter-index == 2 ? (Brand.dark ? #2A303C : #E2E8F0) : transparent;
                                Text {
                                    text: "Bíblia";
                                    font-size: 11px;
                                    font-weight: root.media-filter-index == 2 ? 700 : 500;
                                    color: root.media-filter-index == 2 ? Brand.ink : Brand.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                TouchArea { clicked => { root.media-filter-index = 2; } }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Brand.outline;
                        }

                        // Lista de Mídias disponíveis na biblioteca
                        media-list := ListView {
                            for item in root.media-library-items : Rectangle {
                                height: 50px;
                                border-radius: 8px;
                                background: media-item-touch.has-hover ? Brand.surface-muted : transparent;

                                media-item-touch := TouchArea {
                                    clicked => {
                                        root.select-media-library-item(item.id);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: item.icon;
                                        font-size: 15px;
                                        width: 20px;
                                        horizontal-alignment: center;
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: item.title;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Brand.ink;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.details;
                                            font-size: 11px;
                                            color: Brand.muted;
                                            overflow: elide;
                                        }
                                    }

                                    // Botão adicionar à programação
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: add-touch.has-hover ? (Brand.dark ? #323846 : #CBD5E1) : Brand.surface-muted;

                                        Text {
                                            text: "+";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Brand.ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }

                                        add-touch := TouchArea {
                                            clicked => {
                                                root.add-media-to-program(item.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Brand.outline;
                }

                // ==========================================
                // COLUNA 2: PAINEL DE PROGRAMAÇÃO (Ordem do Culto)
                // ==========================================
                program-column := Rectangle {
                    width: 320px;
                    background: Brand.surface;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        // Cabeçalho da Programação
                        HorizontalLayout {
                            alignment: space-between;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                spacing: 2px;

                                Text {
                                    text: "PROGRAMAÇÃO";
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    color: Brand.subtle;
                                }

                                Text {
                                    text: root.program-title;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Brand.ink;
                                }
                            }

                            // Botão adicionar item
                            Rectangle {
                                height: 26px;
                                border-radius: 13px;
                                background: add-prog-touch.has-hover ? (Brand.dark ? #2A303C : #E2E8F0) : Brand.surface-muted;
                                border-width: 1px;
                                border-color: Brand.outline;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 4px;
                                    cross-axis-alignment: center;

                                    Text { text: "+"; font-size: 13px; font-weight: 700; color: Brand.ink; }
                                    Text { text: "Item"; font-size: 11px; font-weight: 600; color: Brand.ink; }
                                }

                                add-prog-touch := TouchArea {
                                    clicked => {
                                        root.toggle-command-palette();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Brand.outline;
                        }

                        // Lista sequencial de itens da programação
                        program-list := ListView {
                            for item in root.program-items : Rectangle {
                                height: 56px;
                                border-radius: 10px;
                                background: item.is-active
                                    ? (Brand.dark ? #1F2633 : #E8ECF2)
                                    : (prog-item-touch.has-hover ? Brand.surface-muted : transparent);
                                border-width: item.is-active ? 1px : 0px;
                                border-color: Brand.dark ? #3B4556 : #CBD5E1;

                                prog-item-touch := TouchArea {
                                    clicked => {
                                        root.select-program-item(item.id);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    // Número da ordem
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: item.is-active ? (Brand.dark ? #323E54 : #CBD5E1) : Brand.surface-muted;

                                        Text {
                                            text: item.order;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Brand.ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }

                                    // Ícone da categoria
                                    Text {
                                        text: item.kind-icon;
                                        font-size: 15px;
                                    }

                                    // Título e Subtítulo
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: item.title;
                                            font-size: 13px;
                                            font-weight: item.is-active ? 700 : 600;
                                            color: Brand.ink;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.subtitle + " · " + item.slides-count + " telas";
                                            font-size: 11px;
                                            color: Brand.muted;
                                            overflow: elide;
                                        }
                                    }

                                    // Indicador ativo
                                    if item.is-active : Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Brand.output-accent;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Brand.outline;
                }

                // ==========================================
                // COLUNA 3: PAINEL DE PREVIEW DAS MÍDIAS (Slides e Projeção)
                // ==========================================
                preview-column := Rectangle {
                    horizontal-stretch: 1;
                    background: Brand.page;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        // Cabeçalho do Preview
                        preview-header := Rectangle {
                            height: 48px;
                            background: Brand.surface;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Brand.outline;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                cross-axis-alignment: center;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: root.preview-header-title;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Brand.ink;
                                    }

                                    Text {
                                        text: root.preview-header-subtitle;
                                        font-size: 11px;
                                        color: Brand.muted;
                                    }
                                }

                                // Indicadores de estado da tela pública (Live / Blackout / Clear)
                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    if root.is-blackout : Rectangle {
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #EF444422;
                                        border-width: 1px;
                                        border-color: #EF4444;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: "BLACKOUT ATIVO";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #EF4444;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.is-clear-text : Rectangle {
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #F59E0B22;
                                        border-width: 1px;
                                        border-color: #F59E0B;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: "TEXTO OCULTO";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #F59E0B;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.is-logo-screen : Rectangle {
                                        height: 24px;
                                        border-radius: 12px;
                                        background: #3B82F622;
                                        border-width: 1px;
                                        border-color: #3B82F6;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            Text {
                                                text: "LOGO NA TELA";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #3B82F6;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Lista visual dos slides do item selecionado
                        slides-container := Rectangle {
                            vertical-stretch: 1;
                            background: Brand.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Brand.outline;
                            clip: true;

                            if root.preview-slides.length == 0 : VerticalLayout {
                                alignment: center;
                                cross-axis-alignment: center;
                                spacing: 10px;
                                padding: 40px;

                                Text {
                                    text: "📺";
                                    font-size: 32px;
                                }

                                Text {
                                    text: "Nenhuma mídia selecionada para visualização";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: Brand.ink;
                                }

                                Text {
                                    text: "Clique em um item na Programação ou adicione uma música da Sidebar.";
                                    font-size: 13px;
                                    color: Brand.muted;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.preview-slides.length > 0 : ListView {
                                for slide in root.preview-slides : Rectangle {
                                    height: 120px;

                                    // Moldura do Slide (Simula a tela 16:9 de projeção)
                                    slide-card := Rectangle {
                                        x: 8px;
                                        y: 6px;
                                        width: parent.width - 16px;
                                        height: parent.height - 12px;
                                        background: Brand.output-bg;
                                        border-radius: 8px;
                                        border-width: slide.is-live ? 2px : (slide.index == root.selected-slide-index ? 2px : 1px);
                                        border-color: slide.is-live ? Brand.output-accent : (slide.index == root.selected-slide-index ? #3B82F6 : Brand.outline);
                                        clip: true;

                                        TouchArea {
                                            clicked => {
                                                root.select-slide(slide.index);
                                            }
                                        }

                                        VerticalLayout {
                                            padding: 12px;
                                            alignment: space-between;

                                            // Topo do slide: Rótulo e Badge Ao Vivo
                                            HorizontalLayout {
                                                alignment: space-between;
                                                cross-axis-alignment: center;

                                                Text {
                                                    text: slide.label;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    letter-spacing: 0.5px;
                                                    color: Brand.output-muted;
                                                }

                                                if slide.is-live : Rectangle {
                                                    width: 62px;
                                                    height: 20px;
                                                    border-radius: 10px;
                                                    background: Brand.output-accent;

                                                    Text {
                                                        text: "AO VIVO";
                                                        font-size: 10px;
                                                        font-weight: 800;
                                                        color: #000000;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: 100%;
                                                        height: 100%;
                                                    }
                                                }
                                            }

                                            // Conteúdo do slide centralizado
                                            Text {
                                                text: slide.text-content;
                                                font-size: 16px;
                                                font-weight: 600;
                                                color: Brand.output-ink;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                wrap: word-wrap;
                                            }

                                            // Espaço inferior
                                            Rectangle { height: 4px; }
                                        }
                                    }
                                }
                            }
                        }

                        // Barra de Controle de Projeção na base do Preview
                        projection-controls := Rectangle {
                            height: 60px;
                            background: Brand.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Brand.outline;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                alignment: space-between;
                                cross-axis-alignment: center;

                                // Botão AO VIVO em destaque
                                live-btn := Rectangle {
                                    height: 40px;
                                    border-radius: 8px;
                                    background: live-touch.has-hover ? #22C55E : #16A34A;

                                    live-touch := TouchArea {
                                        clicked => {
                                            root.action-go-live(root.selected-slide-index);
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 8px;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Text { text: "▶"; font-size: 13px; color: #FFFFFF; }
                                        Text { text: "AO VIVO"; font-size: 13px; font-weight: 800; color: #FFFFFF; }
                                    }
                                }

                                // Controles de Tela (Black, Clear, Logo)
                                HorizontalLayout {
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    // Botão Limpar Tela (Blackout)
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        background: root.is-blackout ? (Brand.dark ? #3A2323 : #FEE2E2) : (black-touch.has-hover ? Brand.surface-muted : transparent);
                                        border-width: 1px;
                                        border-color: root.is-blackout ? #EF4444 : Brand.outline;

                                        black-touch := TouchArea {
                                            clicked => {
                                                root.action-toggle-blackout();
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            Text {
                                                text: "Limpar Tela (F5)";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: root.is-blackout ? #EF4444 : Brand.ink;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Botão Ocultar Texto
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        background: root.is-clear-text ? (Brand.dark ? #3A3223 : #FEF3C7) : (text-touch.has-hover ? Brand.surface-muted : transparent);
                                        border-width: 1px;
                                        border-color: root.is-clear-text ? #F59E0B : Brand.outline;

                                        text-touch := TouchArea {
                                            clicked => {
                                                root.action-toggle-clear-text();
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            Text {
                                                text: "Ocultar Texto (F6)";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: root.is-clear-text ? #F59E0B : Brand.ink;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Botão Logotipo
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        background: root.is-logo-screen ? (Brand.dark ? #232B3A : #DBEAFE) : (logo-touch.has-hover ? Brand.surface-muted : transparent);
                                        border-width: 1px;
                                        border-color: root.is-logo-screen ? #3B82F6 : Brand.outline;

                                        logo-touch := TouchArea {
                                            clicked => {
                                                root.action-toggle-logo();
                                            }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            Text {
                                                text: "Logo (F7)";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: root.is-logo-screen ? #3B82F6 : Brand.ink;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Brand.outline;
            }

            // 3. Rodapé Discreto (Status Bar)
            status-bar := Rectangle {
                height: 28px;
                background: Brand.surface-muted;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 16px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.db-ready ? Brand.success : Brand.warning;
                        }

                        Text {
                            text: root.db-ready ? "Banco SQLite Conectado" : "Banco Indisponível";
                            color: Brand.subtle;
                            font-size: 11px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        cross-axis-alignment: center;

                        Text {
                            text: "Atalhos: ⌘K / Ctrl+K (Comandos) · F5 (Blackout) · F6 (Limpar Texto)";
                            color: Brand.subtle;
                            font-size: 11px;
                        }

                        Text {
                            text: "OpenPresenter v" + root.app-version;
                            color: Brand.subtle;
                            font-size: 11px;
                        }
                    }
                }
            }
        }

        // ==========================================
        // COMMAND PALETTE (Modal sobreposto)
        // ==========================================
        palette-overlay := CommandPalette {
            is-open <=> root.command-palette-open;
            search-query <=> root.palette-search-query;
            selected-category <=> root.palette-selected-category;
            selected-index <=> root.palette-selected-index;
            results: root.palette-results;

            query-changed(q) => {
                root.palette-query-changed(q);
            }

            category-selected(c) => {
                root.palette-category-selected(c);
            }

            item-activated(id) => {
                root.palette-execute-command(id);
            }

            close => {
                root.close-command-palette();
            }
        }
    }

    // Popup do Menu Configurações
    settings-menu := PopupMenu {
        items: [
            {
                text: "Configurações…",
                enabled: true,
            },
        ];
        x: menu-button.absolute-position.x + menu-button.width - settings-menu.width;
        y: menu-button.absolute-position.y + menu-button.height;

        activated(index) => {
            settings-menu.close();
            root.open-settings();
        }
    }
}
